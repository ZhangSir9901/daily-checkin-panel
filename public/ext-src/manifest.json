{
  "action": {
    "default_popup": "popup.html",
    "default_title": "cookie插件2.2：一键取 Cookie、本地网络中继、浏览器签到",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "description": "签到面板助手：一键取 Cookie、本地网络中继、需要时自动完成浏览器签到",
  "minimum_chrome_version": "110",
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "manifest_version": 3,
  "name": "cookie插件2.2",
  "permissions": [
    "cookies",
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "tabs"
  ],
  "version": "2.6"
}
